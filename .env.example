# ============================================
# INSTARENT ENVIRONMENT VARIABLES
# ============================================

# --- Milestone 1: Foundation ---
# Telegram: Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Convex: Auto-generated when you run `npx convex dev`
CONVEX_URL=

# --- Milestone 2: Property Search (via Smithery) ---
# Smithery: https://smithery.ai/
SMITHERY_API_KEY=

# Exa: https://exa.ai/
EXA_API_KEY=

# --- Milestone 3: Voice Responses ---
# ElevenLabs: https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Milestone 4: Outbound Calls ---
# Twilio: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Milestone 5: Appointments ---
# Calendly: https://developer.calendly.com/
CALENDLY_API_KEY=
CALENDLY_USER_URI=

# --- Milestone 6: Contracts ---
# DocuSign: https://developers.docusign.com/
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_PRIVATE_KEY_PATH=./docusign_private_key.pem

# --- Milestone 7: Payments ---
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: App Config ---
NODE_ENV=development
LOG_LEVEL=debug
